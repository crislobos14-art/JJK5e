 "system": {
  "description": {
   "value": "<table>\n<thead>\n<tr>\n<th>Level</th>\n<th>Prof</th>\n<th style=\"text-align: left;\">Features</th>\n<th>Total Cursed Energy Points</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Innate  Technique, Quick Recovery</td>\n<td>2 + CE modifier</td>\n</tr>\n<tr>\n<td>2</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Technique Creativity</td>\n<td>4 + CE modifier</td>\n</tr>\n<tr>\n<td>3</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Innate Technique Feature</td>\n<td>6 + CE modifier</td>\n</tr>\n<tr>\n<td>4</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td>8 + CE modifier</td>\n</tr>\n<tr>\n<td>5</td>\n<td>+3</td>\n<td style=\"text-align: left;\"></td>\n<td>10 + CE modifier</td>\n</tr>\n<tr>\n<td>6</td>\n<td>+3</td>\n<td style=\"text-align: left;\">Innate  Technique Feature, Ability Score Improvement</td>\n<td>12 + CE modifier</td>\n</tr>\n<tr>\n<td>7</td>\n<td>+3</td>\n<td style=\"text-align: left;\"></td>\n<td>14 + CE modifier</td>\n</tr>\n<tr>\n<td>8</td>\n<td>+3</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td>16 + CE modifier</td>\n</tr>\n<tr>\n<td>9</td>\n<td>+4</td>\n<td style=\"text-align: left;\"></td>\n<td>18 + CE modifier</td>\n</tr>\n<tr>\n<td>10</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td>20 + CE modifier</td>\n</tr>\n<tr>\n<td>11</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Innate  Technique Feature</td>\n<td>22 + CE modifier</td>\n</tr>\n<tr>\n<td>12</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td>24 + CE modifier</td>\n</tr>\n<tr>\n<td>13</td>\n<td>+5</td>\n<td style=\"text-align: left;\"></td>\n<td>26 + CE modifier</td>\n</tr>\n<tr>\n<td>14</td>\n<td>+5</td>\n<td style=\"text-align: left;\"></td>\n<td>28 + CE modifier</td>\n</tr>\n<tr>\n<td>15</td>\n<td>+5</td>\n<td style=\"text-align: left;\">Sorcerous Restoration</td>\n<td>30 + CE modifier</td>\n</tr>\n<tr>\n<td>16</td>\n<td>+5</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td>32 + CE modifier</td>\n</tr>\n<tr>\n<td>17</td>\n<td>+6</td>\n<td style=\"text-align: left;\"></td>\n<td>34 + CE modifier</td>\n</tr>\n<tr>\n<td>18</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Innate  Technique Feature</td>\n<td>36 + CE modifier</td>\n</tr>\n<tr>\n<td>19</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td>38 + CE modifier</td>\n</tr>\n<tr>\n<td>20</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Signature Move</td>\n<td>40 + CE modifier</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Hit Points</strong></p>\n<p><strong>Hit Dice:</strong> 1d6 per strategist level<br />\n<strong>Hit Points at 1st Level:</strong> 6 + your Constitution modifier<br />\n<strong>Hit Points at Higher Levels:</strong> 1d6 (or 4) + your Constitution modifier per strategist level after 1st</p>\n<p><strong>Proficiencies</strong></p>\n<p><strong>Armor:</strong> None</p>\n<p><strong>Weapons:</strong> Daggers, darts, slings, quarterstaffs, and handguns</p>\n<p><strong>Tools:</strong> None</p>\n<p><strong>Saving Throws:</strong> Intelligence, Wisdom</p>\n<p><strong>Skills:</strong> Choose two from Arcana, History, Insight, Investigation, Medicine, and Religion</p>\n<p><strong>Equipment</strong></p>\n<ul>\n<li>\n<p>(a) a handgun or (b) a dagger  </p>\n</li>\n<li>\n<p>(a) a component pouch or (b) an arcane focus  </p>\n</li>\n<li>\n<p>(a) a scholar's pack or (b) an explorer's pack  </p>\n</li>\n<li>\n<p>A technique manual</p>\n</li>\n</ul>\n<p><strong>Innate Technique</strong></p>\n<p>At 1st level choose an Innate Technique from the <em>JJK 5e: Innate Techniques</em> compendium. Add its features at 1st, 3rd, 6th, 11th and 18th level (see <em>Innate Technique Feature</em> in the table).</p>"
  },
