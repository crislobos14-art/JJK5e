 "system": {
  "description": {
   "value": "<table>\n<thead>\n<tr>\n<th>Level</th>\n<th>Prof</th>\n<th style=\"text-align: left;\">Features</th>\n<th style=\"text-align: center;\">Speed Bonus</th>\n<th style=\"text-align: center;\">Dmg Dice</th>\n<th>Total Cursed Energy Points</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Innate  Technique, Quick Strikes, Unparalleled Movement</td>\n<td style=\"text-align: center;\">+10</td>\n<td style=\"text-align: center;\">d4</td>\n<td>1 + CE modifier</td>\n</tr>\n<tr>\n<td>2</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Swift Movements,  Sharp Eyes</td>\n<td style=\"text-align: center;\">+10</td>\n<td style=\"text-align: center;\">d4</td>\n<td>2 + CE modifier</td>\n</tr>\n<tr>\n<td>3</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Innate Technique Feature</td>\n<td style=\"text-align: center;\">+10</td>\n<td style=\"text-align: center;\">d4</td>\n<td>3 + CE modifier</td>\n</tr>\n<tr>\n<td>4</td>\n<td>+2</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td style=\"text-align: center;\">+10</td>\n<td style=\"text-align: center;\">d4</td>\n<td>4 + CE modifier</td>\n</tr>\n<tr>\n<td>5</td>\n<td>+3</td>\n<td style=\"text-align: left;\">Eagle Eyes, Extra Attack</td>\n<td style=\"text-align: center;\">+15</td>\n<td style=\"text-align: center;\">d6</td>\n<td>5 + CE modifier</td>\n</tr>\n<tr>\n<td>6</td>\n<td>+3</td>\n<td style=\"text-align: left;\">Innate  Technique Feature</td>\n<td style=\"text-align: center;\">+15</td>\n<td style=\"text-align: center;\">d6</td>\n<td>6 + CE modifier</td>\n</tr>\n<tr>\n<td>7</td>\n<td>+3</td>\n<td style=\"text-align: left;\">Evasion</td>\n<td style=\"text-align: center;\">+15</td>\n<td style=\"text-align: center;\">d6</td>\n<td>7 + CE modifier</td>\n</tr>\n<tr>\n<td>8</td>\n<td>+3</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td style=\"text-align: center;\">+15</td>\n<td style=\"text-align: center;\">d6</td>\n<td>8 + CE modifier</td>\n</tr>\n<tr>\n<td>9</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Improved Unparalleled Movement</td>\n<td style=\"text-align: center;\">+20</td>\n<td style=\"text-align: center;\">d6</td>\n<td>9 + CE modifier</td>\n</tr>\n<tr>\n<td>10</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Tactical Retreat</td>\n<td style=\"text-align: center;\">+20</td>\n<td style=\"text-align: center;\">d6</td>\n<td>10 + CE modifier</td>\n</tr>\n<tr>\n<td>11</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Innate  Technique Feature</td>\n<td style=\"text-align: center;\">+20</td>\n<td style=\"text-align: center;\">d8</td>\n<td>11 + CE modifier</td>\n</tr>\n<tr>\n<td>12</td>\n<td>+4</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td style=\"text-align: center;\">+20</td>\n<td style=\"text-align: center;\">d8</td>\n<td>12 + CE modifier</td>\n</tr>\n<tr>\n<td>13</td>\n<td>+5</td>\n<td style=\"text-align: left;\">Scanning Eyes</td>\n<td style=\"text-align: center;\">+25</td>\n<td style=\"text-align: center;\">d8</td>\n<td>13 + CE modifier</td>\n</tr>\n<tr>\n<td>14</td>\n<td>+5</td>\n<td style=\"text-align: left;\">Sixth Sense</td>\n<td style=\"text-align: center;\">+25</td>\n<td style=\"text-align: center;\">d8</td>\n<td>14 + CE modifier</td>\n</tr>\n<tr>\n<td>15</td>\n<td>+5</td>\n<td style=\"text-align: left;\">Tactical Retreat Improvement</td>\n<td style=\"text-align: center;\">+25</td>\n<td style=\"text-align: center;\">d8</td>\n<td>15 + CE modifier</td>\n</tr>\n<tr>\n<td>16</td>\n<td>+5</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td style=\"text-align: center;\">+25</td>\n<td style=\"text-align: center;\">d8</td>\n<td>16 + CE modifier</td>\n</tr>\n<tr>\n<td>17</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Swift Dodge</td>\n<td style=\"text-align: center;\">+30</td>\n<td style=\"text-align: center;\">d10</td>\n<td>17 + CE modifier</td>\n</tr>\n<tr>\n<td>18</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Innate  Technique Feature</td>\n<td style=\"text-align: center;\">+30</td>\n<td style=\"text-align: center;\">d10</td>\n<td>18 + CE modifier</td>\n</tr>\n<tr>\n<td>19</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Ability Score Improvement</td>\n<td style=\"text-align: center;\">+30</td>\n<td style=\"text-align: center;\">d10</td>\n<td>19 + CE modifier</td>\n</tr>\n<tr>\n<td>20</td>\n<td>+6</td>\n<td style=\"text-align: left;\">Unfathomable Speed</td>\n<td style=\"text-align: center;\">+35</td>\n<td style=\"text-align: center;\">d10</td>\n<td>20 + CE modifier</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Hit Points</strong></p>\n<p><strong>Hit Dice:</strong> 1d8 per scout level<br />\n<strong>Hit Points at 1st Level:</strong> 8 + your Constitution modifier<br />\n<strong>Hit Points at Higher Levels:</strong> 1d8 (or 5) + your Constitution modifier per scout level after 1st</p>\n<p><strong>Proficiencies</strong></p>\n<p><strong>Armor:</strong> Light armor<br />\n<strong>Weapons:</strong> Simple weapons, handguns, longswords, rapiers, and shortswords<br />\n<strong>Tools:</strong> None<br />\n<strong>Saving Throws:</strong> Dexterity, Wisdom<br />\n<strong>Skills:</strong> Choose three skills from Acrobatics, Animal Handling, Athletics, History, Insight, Intimidation, Perception, and Survival</p>\n<p><strong>Equipment</strong></p>\n<ul>\n<li>\n<p>(a) a rapier or (b) a shortsword  </p>\n</li>\n<li>\n<p>(a) a shortbow and quiver of 20 arrows or (b) a shortsword  </p>\n</li>\n<li>\n<p>(a) a burglar's pack, (b) dungeoneer's pack, or (c) an explorer's pack  </p>\n</li>\n<li>\n<p>Dense coat, two daggers, and thieves' tools</p>\n</li>\n</ul>\n<p><strong>Innate Technique</strong></p>\n<p>At 1st level choose an Innate Technique from the <em>JJK 5e: Innate Techniques</em> compendium. Add its features at 1st, 3rd, 6th, 11th and 18th level (see <em>Innate Technique Feature</em> in the table).</p>"
  },
