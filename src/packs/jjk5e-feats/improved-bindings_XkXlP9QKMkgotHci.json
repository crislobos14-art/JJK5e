 "name": "Improved Bindings",
 "type": "feat",
 "img": "modules/jjk5e/icons/techniques/shadow-killer.svg",
 "system": {
  "description": {
   "value": "<p><em>Prerequisite: Must have Dark Binding</em></p>\n<p>You have improved your technique and can cause shadows to physically wrap around the target, giving you the following additional effects when you use your technique:</p>\n<ul>\n<li>\n<p>A creature must spend an attack to make a Strength (Athletics) or Dexterity (Sleight of Hand) check to remove the weapon.  </p>\n</li>\n<li>\n<p>The target is treated as having two levels of exhaustion.  </p>\n</li>\n<li>\n<p>The target must make a Constitution saving throw at the end of their turn or be stunned until the beginning of their next turn.</p>\n</li>\n</ul>",
   "chat": ""
  },
