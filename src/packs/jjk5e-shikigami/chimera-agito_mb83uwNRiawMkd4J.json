   "_id": "kTm5jcjrHRjk9A77",
   "name": "Reverse Cursed Energy Aura",
   "type": "feat",
   "img": "icons/svg/aura.svg",
   "system": {
    "description": {
     "value": "<p>Agito has a 10 feet aura of reverse cursed energy around it at all times. Agito can spend 10 healing from its RCT Pool for each creature within its aura at the start of its turn, healing them for that amount. This aura also functions as an antimagic aura for all creatures other than its summoner. A creature that attempts to use cursed energy must make a DC 15 Cursed Energy check or be unable to use cursed energy while they are within the aura. Agito can suppress this aura while concentrating.</p>",
     "chat": ""
    },
