mula": "1d20", "replacement": true, "displayRoll": true, "results": [{"_id": "iOJ7xS9MoFdjiiT3", "type": "text", "text": "<p><strong>Innocent: The person is innocent but accused of a heinous crime which is easily excusable. You fail unless the defendant admits to it for some reason, if so a dependent punishment can apply.</strong></p>", "description": "<p><strong>Innocent: The person is innocent but accused of a heinous crime which is easily excusable. You fail unless the defendant admits to it for some reason, if so a dependent punishment can apply.</strong></p>", "name": "Innocent: The person is innocent but accused of a heinous crime which is easily excusable. You fail unless the defendant admits to it for some reason, if so a dependent punishment can apply.", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [1, 1], "drawn": false}, {"_id": "2m1xvMOahzWnZHz2", "type": "text", "text": "<p><strong>Guilty: The person is guilty of a small crime with minimum evidence, your roll is normal. Confiscation</strong></p>", "description": "<p><strong>Guilty: The person is guilty of a small crime with minimum evidence, your roll is normal. Confiscation</strong></p>", "name": "Guilty: The person is guilty of a small crime with minimum evidence, your roll is normal. Confiscation", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [2, 9], "drawn": false}, {"_id": "0ZnLe2JYDTLSqTN6", "type": "text", "text": "<p><strong>Very Guilty: The person is guilty of a crime, and you have good evidence, your roll is at advantage. Confiscation</strong></p>", "description": "<p><strong>Very Guilty: The person is guilty of a crime, and you have good evidence, your roll is at advantage. Confiscation</strong></p>", "name": "Very Guilty: The person is guilty of a crime, and you have good evidence, your roll is at advantage. Confiscation", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [10, 14], "drawn": false}, {"_id": "wWBJQlVODzPkwOf0", "type": "text", "text": "<p><strong>Severely Guilty: The person is guilty of a severe crime, and you have decent evidence. Death Penalty</strong></p>", "description": "<p><strong>Severely Guilty: The person is guilty of a severe crime, and you have decent evidence. Death Penalty</strong></p>", "name": "Severely Guilty: The person is guilty of a severe crime, and you have decent evidence. Death Penalty", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [15, 19], "drawn": false}, {"_id": "i2L1ZXWkfnEalFbr", "type": "text", "text": "<p><strong>Unforgivably Guilty: The person is guilty beyond a doubt of an unforgivable sin, you instantly succeed. Death Penalty, Confiscation</strong></p>", "description": "<p><strong>Unforgivably Guilty: The person is guilty beyond a doubt of an unforgivable sin, you instantly succeed. Death Penalty, Confiscation</strong></p>", "name": "Unforgivably Guilty: The person is guilty beyond a doubt of an unforgivable sin, you instantly succeed. Death Penalty, Confiscation", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [20, 20], "drawn": false}], "flags": {"jjk5e": {}}}, {"_id": "4AcELhsYA3P02glh", "name": "Consequences of Breaking a Binding Vow", "img": "icons/svg/d20-grey.svg", "description": "", "formula": "1d6", "replacement": true, "displayRoll": true, "results": [{"_id": "7vqP2d0AGA40XbDT", "type": "text", "text": "<p><strong>Death.</strong></p>", "description": "<p><strong>Death.</strong></p>", "name": "Death.", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [1, 1], "drawn": false}, {"_id": "mmQDWTVGdD7xuEqX", "type": "text", "text": "<p><strong>You lose a limb.</strong></p>", "description": "<p><strong>You lose a limb.</strong></p>", "name": "You lose a limb.", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [2, 2], "drawn": false}, {"_id": "9UiIKMzLBJlwiRwz", "type": "text", "text": "<p><strong>You lose a sense(D4: 1.Touch, 2. Taste, 3. Smell, 4. Sight)</strong></p>", "description": "<p><strong>You lose a sense(D4: 1.Touch, 2. Taste, 3. Smell, 4. Sight)</strong></p>", "name": "You lose a sense(D4: 1.Touch, 2. Taste, 3. Smell, 4. Sight)", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [3, 3], "drawn": false}, {"_id": "YwjBkgPmKUrjGz2p", "type": "text", "text": "<p><strong>Your stats are reduced by 2.</strong></p>", "description": "<p><strong>Your stats are reduced by 2.</strong></p>", "name": "Your stats are reduced by 2.", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [4, 4], "drawn": false}, {"_id": "OZaoM73Y3iDoqZLE", "type": "text", "text": "<p><strong>You cannot use Cursed Energy for 8d4 days.</strong></p>", "description": "<p><strong>You cannot use Cursed Energy for 8d4 days.</strong></p>", "name": "You cannot use Cursed Energy for 8d4 days.", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [5, 5], "drawn": false}, {"_id": "5cd1JYUQDAfTp4pD", "type": "text", "text": "<p><strong>Your Innate Technique is confiscated for 6d4 days.</strong></p>", "description": "<p><strong>Your Innate Technique is confiscated for 6d4 days.</strong></p>", "name": "Your Innate Technique is confiscated for 6d4 days.", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [6, 6], "drawn": false}], "flags": {"jjk5e": {}}}, {"_id": "TEGRIdhr0OKly0mZ", "name": "Limb Damage Table", "img": "icons/svg/d20-grey.svg", "description": "", "formula": "1d6", "replacement": true, "displayRoll": true, "results": [{"_id": "hIRRddOoIpEq1kjK", "type": "text", "text": "<p><strong>Right Leg</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Your movement is halved and you can’t jump. — <strong>Lost Limb:</strong> You lose your right leg.</p>", "description": "<p><strong>Right Leg</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Your movement is halved and you can’t jump. — <strong>Lost Limb:</strong> You lose your right leg.</p>", "name": "Right Leg", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [1, 1], "drawn": false}, {"_id": "CNMNGw3rs3MbzIhb", "type": "text", "text": "<p><strong>Left Leg</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Your movement is halved and you can’t jump. — <strong>Lost Limb:</strong> You lose your left leg.</p>", "description": "<p><strong>Left Leg</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Your movement is halved and you can’t jump. — <strong>Lost Limb:</strong> You lose your left leg.</p>", "name": "Left Leg", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [2, 2], "drawn": false}, {"_id": "B9be7JqPrJ8pVW0e", "type": "text", "text": "<p><strong>Right Arm</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Skill checks and attack rolls using this arm have disadvantage. — <strong>Lost Limb:</strong> Skill checks and attack rolls with this arm are impossible.</p>", "description": "<p><strong>Right Arm</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Skill checks and attack rolls using this arm have disadvantage. — <strong>Lost Limb:</strong> Skill checks and attack rolls with this arm are impossible.</p>", "name": "Right Arm", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [3, 3], "drawn": false}, {"_id": "bFW8z75AqXo9Bgi7", "type": "text", "text": "<p><strong>Left Arm</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Skill checks and attack rolls using this arm have disadvantage. — <strong>Lost Limb:</strong> Skill checks and attack rolls with this arm are impossible.</p>", "description": "<p><strong>Left Arm</strong> — <strong>Required Damage:</strong> Con mod×Level — <strong>Broken Limb:</strong> Skill checks and attack rolls using this arm have disadvantage. — <strong>Lost Limb:</strong> Skill checks and attack rolls with this arm are impossible.</p>", "name": "Left Arm", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [4, 4], "drawn": false}, {"_id": "hg7qSG6qEmDF4dBt", "type": "text", "text": "<p><strong>Torso</strong> — <strong>Required Damage:</strong> Con mod×(Level×2) — <strong>Broken Limb:</strong> Max HP is halved. — <strong>Lost Limb:</strong> The target dies unless it can live without a torso.</p>", "description": "<p><strong>Torso</strong> — <strong>Required Damage:</strong> Con mod×(Level×2) — <strong>Broken Limb:</strong> Max HP is halved. — <strong>Lost Limb:</strong> The target dies unless it can live without a torso.</p>", "name": "Torso", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [5, 5], "drawn": false}, {"_id": "HIwB7SftvvqNZ0R0", "type": "text", "text": "<p><strong>Head</strong> — <strong>Required Damage:</strong> Con mod×(Level×2) — <strong>Broken Limb:</strong> The target is unconscious. — <strong>Lost Limb:</strong> The target dies unless it can live without a head.</p>", "description": "<p><strong>Head</strong> — <strong>Required Damage:</strong> Con mod×(Level×2) — <strong>Broken Limb:</strong> The target is unconscious. — <strong>Lost Limb:</strong> The target dies unless it can live without a head.</p>", "name": "Head", "img": "icons/svg/d20-black.svg", "weight": 1, "range": [6, 6], "drawn": false}], "flags": {"jjk5e": {}}}]}