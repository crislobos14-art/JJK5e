{
  "id": "jjk5e",
  "title": "Jujutsu Kaisen 5e (V.6) — Compendium",
  "description": "Unofficial, non-commercial fan conversion of the Jujutsu Kaisen 5e homebrew (V.6) by I watch Anime for the D&D 5e system: 7 classes with level advancement, 79 Innate Techniques, races, feats, backgrounds, mindsets, equipment, cursed tools and the full rules journal. Includes Cursed Energy pool automation. Also includes feats and options from Creeps and Curses V.3.1 (Special Grade Boons, Special Traits, Heavenly Pacts, new techniques). Licensed CC BY-NC-SA 4.0.",
  "version": "1.21.0",
  "authors": [
    {
      "name": "I watch Anime",
      "flags": {
        "role": "Original JJK 5e system author"
      }
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14.370"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0",
          "verified": "6.1.1"
        }
      }
    ],
    "recommends": [
      {
        "id": "sequencer",
        "type": "module",
        "reason": "Plays the JJK 5e attack, technique and domain animations."
      },
      {
        "id": "JB2A_DnD5e",
        "type": "module",
        "reason": "Free animation library used by the JJK 5e animations."
      },
      {
        "id": "autoanimations",
        "type": "module",
        "reason": "Animates official D&D 5e items; JJK items you configure there keep that animation."
      },
      {
        "id": "dice-so-nice",
        "type": "module",
        "reason": "3D dice for Black Flash checks and attack rolls."
      },
      {
        "id": "midi-qol",
        "type": "module",
        "reason": "Full combat automation: attacks, saves and damage applied automatically, Black Flash inside the Midi workflow, reaction prompts for JJK reactions, repeat saves at the end of each turn (OverTime) and domain sure-hit. Use Midi-QOL 14.7.0+ with dnd5e 6.1.",
        "compatibility": {
          "minimum": "14.7.0"
        }
      },
      {
        "id": "visual-active-effects",
        "type": "module",
        "reason": "Shows CE forms, vows, domain and Technique Burnout on screen with their descriptions."
      },
      {
        "id": "barbrawl",
        "type": "module",
        "reason": "Extra token bars: keep HP and Cursed Energy visible at the same time."
      },
      {
        "id": "token-action-hud-dnd5e",
        "type": "module",
        "reason": "Quick action bar for techniques, CE abilities and JJK macros without opening the sheet."
      },
      {
        "id": "fxmaster",
        "type": "module",
        "reason": "Scene particles and filters for domain interiors and curse ambience."
      }
    ]
  },
